# Sidrah Industries — public runtime config
# Copy to .env.local and fill in real values before going live.

# WhatsApp number in international format, digits only (country code + number)
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000

# Shown in the header / footer / contact page
NEXT_PUBLIC_PHONE_DISPLAY=+91 90000 00000
NEXT_PUBLIC_EMAIL=info@sidrahindustries.com

# Used for sitemap + Open Graph absolute URLs
NEXT_PUBLIC_SITE_URL=https://www.sidrahindustries.com
